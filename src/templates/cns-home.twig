{% extends "school-layout.twig" %}

{% block layout_header %}
  {% embed 'partials/school-header.twig' %}
    {% block school_logo %}
      <img
        src="images/cns-logo.png"
        srcset="images/cns-logo.png 1x, images/cns-logo@2x.png 2x"
        width="255px"
        alt="Logo for Middlebury College Nonproliferation Studies"
      />
      <span class="sr-only">Middlebury College Center for Nonproliferation Studies</span>
    {% endblock %}
  {% endembed %}
{% endblock %}

{% block page %}
  <div class="container">
    <div class="row">
      <div class="paragraphs paragraphs--wide">
      {% block content %}{% endblock %}
      </div>
    </div>
  </div>
{% endblock %}
